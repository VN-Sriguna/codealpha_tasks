# CodeAlpha NIDS — local signatures (Snort-style subset)
# Format: action proto src sport -> dst dport (options)
# Options understood by this engine: msg, content, nocase, flags, sid, classtype, priority
#
# These rules look for known-suspicious *patterns in traffic you are authorized
# to monitor*. They do not send packets or exploit hosts.

alert tcp any any -> any 80 (msg:"HTTP directory traversal"; content:"../"; nocase; classtype:web-attack; priority:1; sid:1000001; rev:1;)
alert tcp any any -> any 80 (msg:"Possible SQL injection in HTTP"; content:"' OR "; nocase; classtype:web-attack; priority:1; sid:1000002; rev:1;)
alert tcp any any -> any 80 (msg:"Possible SQL injection UNION"; content:"UNION SELECT"; nocase; classtype:web-attack; priority:1; sid:1000003; rev:1;)
alert tcp any any -> any 80 (msg:"Suspicious HTTP User-Agent sqlmap"; content:"sqlmap"; nocase; classtype:web-attack; priority:1; sid:1000004; rev:1;)
alert tcp any any -> any 443 (msg:"Possible SQL injection in HTTPS-port plaintext"; content:"' OR "; nocase; classtype:web-attack; priority:2; sid:1000005; rev:1;)
alert tcp any any -> any 21 (msg:"FTP login attempt"; content:"USER "; classtype:attempted-login; priority:3; sid:1000010; rev:1;)
alert tcp any any -> any 23 (msg:"Telnet traffic (insecure cleartext)"; content:"login"; nocase; classtype:policy-violation; priority:2; sid:1000011; rev:1;)
alert tcp any any -> any any (msg:"TCP NULL scan (no flags)"; flags:0; classtype:recon; priority:1; sid:1000020; rev:1;)
alert tcp any any -> any any (msg:"TCP FIN scan"; flags:F; classtype:recon; priority:1; sid:1000021; rev:1;)
alert tcp any any -> any any (msg:"TCP XMAS scan"; flags:FPU; classtype:recon; priority:1; sid:1000022; rev:1;)
alert udp any any -> any 53 (msg:"DNS query for onion domain"; content:".onion"; nocase; classtype:policy-violation; priority:2; sid:1000040; rev:1;)
